GEMINI_API_KEY=your_gemini_api_key_here
# Production URL of the "Soch Voice Bot — Lead → CRM + Booking Link" n8n workflow (…/webhook/…, not /webhook-test/)
N8N_WEBHOOK_URL=https://your-n8n-instance.com/webhook/soch-voice-lead
# Shared secret sent as the X-Soch-Secret header; n8n stores only its SHA-256. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
N8N_WEBHOOK_SECRET=your_long_random_secret_here
# Existing Cal.com 30-minute event (public booking page, not a secret)
CAL_BOOKING_URL=https://cal.com/your-username/your-30-min-event
# Optional: overall time budget (ms) for forwarding a lead to n8n, retries included
# LEAD_TIMEOUT_MS=25000
PORT=3000
GEMINI_MODEL=gemini-2.5-flash-native-audio-preview-09-2025
